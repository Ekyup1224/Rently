# Reference for the variables the backend reads. These are DEVELOPMENT values and
# several are published here deliberately, which is exactly why a deployment must
# not use them: ProductionSafetyCheck refuses to start when it finds any of them
# outside the 'dev' profile.
#
# Note this file is not loaded automatically — docker-compose has its own values
# inline, and Spring Boot does not read .env. To use it locally: set -a; . ./.env
#
# `./mvnw spring-boot:run` activates the 'dev' profile and needs none of this; a
# packaged jar gets no profile, so every DEPLOY-ONLY variable below must be set.
POSTGRES_URL=jdbc:postgresql://localhost:5433/stay
POSTGRES_USER=stay
POSTGRES_PASSWORD=stay_dev_password

REDIS_HOST=localhost
REDIS_PORT=6380

# HS256 signing secret. MUST be at least 32 bytes. Generate with:
#   openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-at-least-32-bytes-long!!

# Bootstrap super admin, created on first startup if no SUPER_ADMIN exists.
BOOTSTRAP_ADMIN_PHONE=+97699000000
BOOTSTRAP_ADMIN_EMAIL=admin@stay.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# S3 / MinIO (used from Step 2 onward for photos and KYC documents)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=stayminio
S3_SECRET_KEY=stayminio_dev_password
S3_BUCKET=stay-media

# --- Deploy-only ------------------------------------------------------------
# Not needed locally. Without these a packaged jar refuses to start, by design.

# Comma-separated browser origins allowed to call the API — the deployed guest
# app and partner portal. Leaving localhost here means the real frontends are
# not in the list.
CORS_ALLOWED_ORIGINS=https://example.mn,https://partner.example.mn

# Send real codes. Needs an SmsSender implementation against a carrier; `log`
# writes every sign-in code to the application log.
OTP_DELIVERY=sms
# Never return a sign-in code to the caller: it stops the phone being a factor.
OTP_EXPOSE_CODE=false

# The simulator marks a booking paid without money moving. Must be off.
PAYMENTS_SIMULATED_ENABLED=false
PAYMENTS_SIMULATED_SECRET=generate-another-one

# Create and open the bucket only on a dev MinIO; front real storage with a CDN.
S3_AUTO_CREATE_BUCKET=false
